# Server-only generation keys
OPENAI_API_KEY=
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare

# Optional second-run motion-library adapter; not used by the first-run funnel
OPENROUTER_API_KEY=
OPENROUTER_VIDEO_MODEL=
OPENROUTER_VIDEO_RESOLUTION=480p
OPENROUTER_VIDEO_MAX_PER_SECOND_USD=0.03

# Optional fallback video adapter
FAL_KEY=
VIDEO_PROVIDER=openrouter

# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
NEXT_PUBLIC_CONVEX_SITE_URL=

# Clerk (required for protected production generation)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Instagram publishing beta. Keep the global kill switch false until Meta is configured and tested.
INSTAGRAM_PUBLISHING_ENABLED=false
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
INSTAGRAM_REDIRECT_URI=https://www.cueface.com/api/instagram/callback
INSTAGRAM_GRAPH_VERSION=v25.0
# 32 random bytes encoded as base64, for example: openssl rand -base64 32
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
